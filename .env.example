# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console (console = human-readable for local dev)
DATABASE_URL=sqlite:///./search_intel.db   # any SQLAlchemy URL; e.g. postgresql+psycopg://user:pass@host/db

# ── AI Gateway (LiteLLM-based). All agent LLM calls go through app/gateway ─────
# Model ids use LiteLLM's "<provider>/<model>" form. Fallbacks are comma-separated.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=                  # optional: enables anthropic/* models in routes/fallbacks
GEMINI_API_KEY=                     # optional: enables gemini/* models in routes/fallbacks

GATEWAY_PLANNER_MODEL=openai/gpt-4o-mini
GATEWAY_PLANNER_FALLBACKS=openai/gpt-4o
GATEWAY_RETRIEVAL_MODEL=openai/gpt-4o-mini
GATEWAY_RETRIEVAL_FALLBACKS=
GATEWAY_ANALYST_MODEL=openai/gpt-4o
GATEWAY_ANALYST_FALLBACKS=openai/gpt-4o-mini
GATEWAY_REPORTER_MODEL=openai/gpt-4o-mini
GATEWAY_REPORTER_FALLBACKS=
GATEWAY_TIMEOUT_S=30                # per LLM request
GATEWAY_MAX_RETRIES=2               # retries per model before falling back to the next model
GATEWAY_CACHE_ENABLED=true          # in-memory response cache (temperature-0 requests only)
GATEWAY_CACHE_TTL_S=600
GATEWAY_BREAKER_FAILURE_THRESHOLD=5 # consecutive failures before a model's circuit opens
GATEWAY_BREAKER_RESET_S=30          # seconds before an open circuit half-opens

# LiteLLM: use the bundled model-cost map instead of fetching it at import time.
LITELLM_LOCAL_MODEL_COST_MAP=True

# ── DataForSEO ────────────────────────────────────────────────────────────────
# mock  = realistic fixture responses, zero credentials needed (DEFAULT)
# live  = real API via https://api.dataforseo.com (needs login/password)
# chaos = mock + deterministic failure injection (see DATAFORSEO_CHAOS_SCRIPT)
DATAFORSEO_MODE=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_CONNECT_TIMEOUT_S=5
DATAFORSEO_READ_TIMEOUT_S=30
DATAFORSEO_MAX_ATTEMPTS=4           # 1 initial call + 3 retries (exp backoff + jitter)
DATAFORSEO_RETRY_BASE_DELAY_S=0.5   # set 0 in tests
DATAFORSEO_RETRY_MAX_DELAY_S=8
DATAFORSEO_BREAKER_FAILURE_THRESHOLD=5
DATAFORSEO_BREAKER_RESET_S=30
# Chaos script: per-tool sequence of outcomes consumed one per call, then falls through to mock.
# Outcomes: ok | 429 | 500 | 502 | 503 | 401 | 400 | timeout | malformed
DATAFORSEO_CHAOS_SCRIPT=serp_organic:429,429,ok;llm_responses:500,500,500,500;keyword_volume:timeout,ok

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_MAX_CONCURRENCY=4          # parallel retrieval branches
PIPELINE_RECURSION_LIMIT=60
PIPELINE_DEFAULT_LOCATION_CODE=2840 # United States
PIPELINE_DEFAULT_LANGUAGE_CODE=en
